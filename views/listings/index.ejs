<% layout('layouts/boilarplate') -%>
<div>
    <h1>All Listings</h1>
    <form  method="get" action="/Listings/newPlace">
        <button type="submit">Create New Place</button>
    </form>
    <div class="row row-cols-1 row-cols-sm-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% for(let listing of AllListing){ %>
            <a href="/Listing/<%=listing.id%>" class="listing-link">
            <div class="col">
                <div class="card h-100">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="place image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>

                    <div class="card-body">
                        <b><h4 class="card-title"><%= listing.title %></h4></b>
                        <p class="card-price">&#8377;<%= listing.price.toLocaleString("hi-IN") %></p>
                        <p class="card-text"><%= listing.description %></p>
                    </div>
                </div>
            </div>
        </a>
        <% } %>
    </div>
</div>
