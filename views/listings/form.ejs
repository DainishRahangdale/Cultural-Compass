<% layout('layouts/boilarplate.ejs') -%>
<div class="row">
     <div class="col-8 offset-2">
        <h1>Create new place</h1>
        <form method="post" action="/Listing/new" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="title" class="form-label">Enter Title</label>
                <input id="title" type="text" name="title" class="form-control" required>
            </div>
           
            <div class="mb-3">
                <label for="description" class="form-label">Enter Description</label>
                <textarea id="description" type="text" name="description" class="form-control" required></textarea>
            </div>
           
           <div class="mb-3 col-md-4"> 
            <label for="location" class="form-label">Enter location</label>
            <input required id="location" type="text" name="location" class="form-control">
        </div>
           <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Enter Price</label>
            <input required id="price" type="number" name="price" class="form-control">
           </div>
           <div class="mb-3"> 
             <label for="country" class="form-label">Enter country</label>
            <input required id="country" type="text" name="country" class="form-control">
           </div>
            <div class="mb-3">
                <label for="image" class="form-label">Enter Image URL</label>
            <input id="image" type="text" name="image" class="form-control">
            </div>
            <!--   for images reserve
            <label for="">Enter Title</label>
            <input id="title" type="text" name="title">
            <br/> -->  
            <button type="submit" class="btn btn-dark add-btn">Add</button>
            <br/>
            <br>
        </form>
    
    
     </div>
</div>
   