<% layout('layouts/boilarplate.ejs') -%>
<div  style="max-height: 100rem">
    <div class=" card mt-4" style="max-width: 120rem">
        <div class="row g-3">
          <div class="col-md-6">
            <img src="<%=listing.image.url%>" class="img-fluid rounded-start" alt="place Image">
          </div>
          <div class="col-md-6">
            <div class="card-body">
              <h5 class="card-title"><%= listing.title%></h5>
              <p class="card-text"><%= listing.description%></p>
              <p class="card-text">&#8377;<%= listing.price.toLocaleString("hi-IN")%></p>
              <p><%= listing.location%></p>
              <p><%= listing.country%></p>
              <div class="row mt-auto">
                <a href="/Listing/<%=listing._id%>/edit" class="btn btn-dark col-6">Edit</a>
                <form method="post" action="/listing/<%=listing._id%>?_method=Delete" class="col-6">
                    <button class="btn btn-dark">
                        Delete
                    </button>
                </form>
              </div>
              
            </div>
          </div>
        </div>
      </div>
    
    <br/>
   
</div>
   
