<% layout('layouts/boilarplate') -%>

<body>
    <h1>Listings</h1>
    <ul>
       <img src="<%=listing.image.url%>">
       <li><%= listing.title%></li>
       <li><%= listing.description%></li>
       <li>&#8377;<%= listing.price.toLocaleString("hi-IN")%></li>  
       <!-- to show money in indian ruppe -->
       <li><%= listing.location%></li>
       <li><%= listing.country%></li>
    </ul>
    <br/>
    <a href="/Listing/<%=listing._id%>/edit">Edit this Instance</a>
   <form method="post" action="/listing/<%=listing._id%>?_method=Delete">
       <button>
           Delete
       </button>
   </form>
</body>
   
